#!/bin/sh
# pre-commit：上游 Einfacht gate.py（重渲染 + registry）+ 本仓自定义工具自证。
#
# ★ 2026-11-07「额叶移除」：机制层（zreflect/ + gates-selftest.sh + 钩子骨架）
#   整层换成上游 HEAD。但上游 gate.py 只做「重渲染 + registry --run commit」，
#   不知道本仓 tools/ 里那 5 个生产者工具与解耦闸门 —— 直接换薄壳会丢 6 道防线。
#   ⇒ 本壳 = 上游 gate.py 的 commit 相位 + 本仓追加段，两者都不重复实现。
set -e
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO=$(CDPATH= cd -- "$HERE/.." && pwd)

# ① 上游机制：重渲染机器块 + 跑全部 registry 闸门（唯一产地）
python3 "$HERE/gate.py" commit "$REPO" || exit 1

# ② 本仓 tools/ 纯工具自证（不在 registry 面内 —— registry 只收 zreflect/ 下带声明的闸门）
echo "── tools/ 纯工具自证 ──"
cd "$REPO"
for t in make-manifest-v4 check-release-v4 upgrade-manifest-license \
         check-contract-decoupling compare-release-payloads; do
  python3 "tools/$t.py" --selftest >/dev/null || {
    echo "FATAL: tools/$t.py --selftest 失败"; exit 1; }
done
echo "OK（生成器 / 校验器 / 升级器 / 解耦闸门 / 载荷对账）"

# ③ 解耦闸门的真实数据部分（自证只证判据有牙，这里证当前产物是解耦的）
CATALOG=/mnt/hdd/zcode-projects/Octave-Full-Wasm/site/assets/forge-catalog.json
if [ -f "$CATALOG" ]; then
  python3 tools/check-contract-decoupling.py --market "$CATALOG" >/dev/null || {
    echo "FATAL: 市场表与分发侧耦合了"; exit 1; }
  echo "解耦闸门：市场表 OK"
else
  echo "解耦闸门：市场表不在本机 ⇒ 本次未查，不假装查过" >&2
fi
