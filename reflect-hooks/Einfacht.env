# Einfacht.env —— Octave-Extra-Content 事实系统配置（本仓口径）。
# 由 reflect-hooks/einfacht-env.sh 加载；钩子语境里这是旋钮的唯一可复现来源。
#
# ⚠️ 行尾**不能写 `#` 注释**（经验集坑 1）：`export X="v"  # 注释` 里的文字会被
#    **并进值里**（sh 只在**单词开头**才把 `#` 当注释）⇒ 闸门拿着
#    `build/FACTS.json"   # 本仓…` 去找文件 ⇒ 报"不存在"。注释只能单独成行。

export REFLECT_FACTS="build/FACTS.json"
export REFLECT_DOC="STATE.md"
export REFLECT_DOCS="STATE.md,AGENTS.md,README.md"
export REFLECT_RETRACTIONS="build/retractions.json"
export REFLECT_QUESTIONS="questions"
export REFLECT_READMES="README.md"

# ⚠️ `REFLECT_MEASURE_MODULE` **故意不在这里配**（用默认 measure_extra_content 即可）：
#    它是 value 类旋钮，全局配一份冗余、且无必要（默认名已是本仓数据层）。

# ⚠️ `REFLECT_LOCKS` **故意不在这里全局配**（经验集坑 2，与 DOCTOR / PINS / INSTRUMENTS
#    同族）：它的值是「配了就必须存在」的路径，而 gates-selftest.sh 的**跨仓库夹具**
#    是临时目录、当然没有 build/upstream-lock.json ⇒ 全局配 ⇒ 夹具里 FATAL
#    （可配置性自证红）。⇒ **内联**传给需要它的那次调用（见 reflect-hooks/pre-commit）。
#
# ⚠️ `REFLECT_PINS` 同理不配：本仓没有派生树 pin 的一致性对象（那是宿主侧的
#    容器树 / submodule 见证；本仓只是货架）。通用闸门**明说 OFF**，不假装查过。

# ══ 2026-11-07 额叶移除（机制层升级到上游 b815cd1）══════════════════════════
# ① 上游 facts.py 不再默认 measure_extra_content；不配就回落占位实现（量出空表）。
#    数据层已移到仓根，必须显式分派；build/facts.py 壳负责把仓根加进 PYTHONPATH。
export REFLECT_MEASURE_MODULE="measure_extra_content"

# ② 上游 check_facts.py 新增「反向判据」（issue #24，白名单式）：正文里 ≥ 阈值的
#    数字都必须在台账 / [[键名]] / 形状白名单里有出处。本仓 STATE.md 按旧判据
#    （黑名单式）写了 239 个手抄实测数字 —— 全是历史实测记录，不是错误，但**未按
#    新规范迁移**。
#    ⚠️ 这是**迁移期设置**，不是把闸门关掉：其余判据（块一致性 / 坏引用 / 抄了
#    台账值没引用）全部照跑。待 STATE 迁移完成即删此行，阈值回默认 100。
#    悬案见 questions/06-state-bare-number-migration.md。
export REFLECT_NAKED_MIN=99999999

# ③ 上游 doc.py 把 PRINCIPLES.md 纳入活状态面；本仓没有该文档、也不用它的
#    AUTO:RULES 表。REFLECT_NO_PRINCIPLES 对 --check 目前无效（上游不一致，已报），
#    故 pre-push 的 --check 仍需处理；见悬案同一条。
export REFLECT_NO_PRINCIPLES=1
